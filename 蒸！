  equipValue(c) {
    switch (c.name) {
      case '诸葛连弩': return 5;
      case '青釭剑': case '贯石斧': return 4;
      case '丈八蛇矛': case '雌雄双股剑': return 3;
      case '八卦阵': return 5;
      case '仁王盾': return 4;
      case '赤兔': case '的卢': return 3;
