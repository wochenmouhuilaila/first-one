  },
  async pickCardTarget(game, p, options, t, why) {
    await SGS.sleep(300);
    if (this.enemyScore(game, p, t) > 0) { // 拆敌方：优先防具/武器/加一马，其次乐
      const eq = options.find(o => o.zone === 'equip');
      if (eq) return eq;
    } else { // 帮友军：优先拆乐不思蜀
      const jd = options.find(o => o.zone === 'judge' && o.card.name === '乐不思蜀');
      if (jd) return jd;
