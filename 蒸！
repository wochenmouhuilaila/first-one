              pend.resolve(this.sel.cards.slice());
            } else if (t === 'pickCards') {
              const o = pend.opts;
              if (o.n != null && o.n !== 'any' && this.sel.cards.length !== o.n) { this.toast('需选择 ' + o.n + ' 张'); return; }
