            '<circle cx="20" cy="14" r="9" fill="#f0d9b0" stroke="' + c + '" stroke-width="2"/>' +
            '<path d="M8 40 Q8 26 20 26 Q32 26 32 40 Z" fill="' + c + '" opacity="0.88"/>' +
            '<circle cx="17" cy="13" r="1.6" fill="#333"/><circle cx="23" cy="13" r="1.6" fill="#333"/>' +
